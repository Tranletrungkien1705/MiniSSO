@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Đăng nhập — MiniSSO</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  body { background: radial-gradient(900px 500px at 50% -10%, rgba(99,102,241,.25), transparent 60%), #0b1020;
    min-height:100vh; display:flex; align-items:center; justify-content:center; font-family:"Be Vietnam Pro",sans-serif; }
  .box { background:#fff; border-radius:16px; padding:36px 32px; width:370px; box-shadow:0 20px 60px rgba(0,0,0,.5); }
  .brand { font-size:26px; font-weight:800; color:#111827; } .brand span { color:#6366f1; }
  .btn-p { background:#6366f1; color:#fff; border:none; padding:10px; font-weight:600; } .btn-p:hover { background:#4f46e5; color:#fff; }
  .demo { font-size:12px; background:#f4f4fb; border-radius:8px; padding:10px 12px; }
</style>
</head>
<body>
<div class="box">
  <div class="brand mb-1"><i class="bi bi-shield-lock"></i> Mini<span>SSO</span></div>
  <p class="text-muted mb-4" style="font-size:13px">Đăng nhập một lần cho toàn hệ thống</p>
  <form method="post" action="/Account/Login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:13px">Email hoặc mật khẩu không đúng.</div> }
    <div class="mb-3"><label class="form-label fw-600">Email</label><input type="email" name="email" class="form-control" required autofocus /></div>
    <div class="mb-4"><label class="form-label fw-600">Mật khẩu</label><input type="password" name="password" class="form-control" required /></div>
    <button class="btn btn-p w-100">Đăng nhập</button>
  </form>
  <div class="demo mt-4">
    <div class="fw-600 mb-1" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#6b7280">Tài khoản demo</div>
    <div><code>admin@minisso.dev</code> / <code>Admin@123</code></div>
    <div><code>sales@minisso.dev</code> / <code>Sales@123</code></div>
    <div><code>dealer@minisso.dev</code> / <code>Dealer@123</code></div>
  </div>
</div>
</body>
</html>
