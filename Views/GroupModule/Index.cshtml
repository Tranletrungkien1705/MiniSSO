@{
    ViewData["Title"] = "Gán module vào nhóm";
    var groups = (List<Group>)ViewBag.Groups;
    var selected = (Group?)ViewBag.Selected;
    var modules = (List<MiniSSO.Services.ModuleGrant>)ViewBag.Modules;
    var grantedCount = modules.Count(m => m.Granted);
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Chọn nhóm</h6>
            @if (groups.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có nhóm nào. Tạo nhóm ở mục <a href="/Group">Nhóm &amp; Phân quyền</a>.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var g in groups)
                    {
                        var active = selected != null && selected.Id == g.Id;
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(active ? "active" : "")"
                           href="@Url.Action("Index", new { groupId = g.Id })">
                            <span><code class="@(active ? "text-white" : "")">@g.Code</code> <span class="small">@g.Name</span></span>
                            @if (!g.IsActive) { <span class="badge bg-secondary">khóa</span> }
                        </a>
                    }
                </div>
            }
            <p class="text-muted small mt-3 mb-0">
                Port từ iNOS.InBrand: <code>Sys_Access</code> (GroupCode + ModuleCode) — nối TRỰC TIẾP nhóm ↔ module.
                Màn hình <code>SysGroupController.GetSysModule</code> liệt kê tất cả module kèm cờ đã gán
                (<code>GetAllAccessByGroupCode</code>); lưu theo cơ chế thay-thế toàn bộ (<code>SysAccessSave_New20171101</code>).
            </p>
        </div></div>
    </div>

    <div class="col-lg-8">
        @if (selected == null)
        {
            <div class="card"><div class="card-body"><p class="text-muted mb-0">Chọn một nhóm để gán module.</p></div></div>
        }
        else
        {
            <div class="card"><div class="card-body">
                <h6 class="fw-bold mb-3">Module của nhóm <code>@selected.Code</code> — đã gán @grantedCount/@modules.Count</h6>
                @if (modules.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có module nào. Tạo module ở mục <a href="/Module">Phân hệ chức năng</a>.</p>
                }
                else
                {
                    <form asp-action="SaveModules" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="groupId" value="@selected.Id" />
                        <table class="table align-middle mb-3">
                            <thead><tr><th style="width:60px" class="text-center">Gán</th><th>Mã module</th><th>Tiêu đề</th><th>Loại</th></tr></thead>
                            <tbody>
                            @foreach (var m in modules)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input class="form-check-input" type="checkbox" name="moduleCodes" value="@m.Module.Code" @(m.Granted ? "checked" : "") />
                                    </td>
                                    <td><code>@m.Module.Code</code></td>
                                    <td>@m.Module.Title</td>
                                    <td class="text-muted small">@m.Module.ModuleType</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu module cho nhóm</button>
                    </form>
                }
            </div></div>
        }
    </div>
</div>
