@model List<AppUser>
@{
    ViewData["Title"] = "Người dùng";
    var orgs = (List<Org>)ViewBag.Orgs;
    var orgById = orgs.ToDictionary(o => o.Id, o => o);
}
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm người dùng</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="email" type="email" class="form-control" placeholder="Email *" required /></div>
            <div class="mb-2"><input name="fullName" class="form-control" placeholder="Họ tên" /></div>
            <div class="mb-2"><input name="password" type="text" class="form-control" placeholder="Mật khẩu *" required /></div>
            <div class="row g-2 mb-3">
                <div class="col-6"><input name="roles" class="form-control" placeholder="Vai trò (csv)" /></div>
                <div class="col-6"><input name="tenant" class="form-control" placeholder="Tổ chức" /></div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-person-plus me-1"></i>Tạo</button>
        </form>
        <p class="text-muted small mt-3 mb-0">Mật khẩu băm PBKDF2-SHA256 (100k vòng).</p>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle"><thead><tr><th>Email</th><th>Họ tên</th><th>Vai trò</th><th>Tổ chức</th><th>TT</th><th>Bảo mật</th><th></th></tr></thead><tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="fw-semibold">@u.Email</td><td>@u.FullName</td>
                <td>@foreach (var r in u.RoleList) { <span class="badge bg-light text-dark me-1">@r</span> }</td>
                <td class="small text-muted">@u.Tenant</td>
                <td>@if (u.IsActive) { <span class="badge bg-success">bật</span> } else { <span class="badge bg-secondary">khóa</span> }</td>
                <td class="small">
                    @if (u.IsLockedOut) { <span class="badge bg-danger">đang khoá</span> }
                    else if (u.FailedLoginCount > 0) { <span class="badge bg-warning text-dark">sai @u.FailedLoginCount lần</span> }
                    else { <span class="text-muted">—</span> }
                </td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#edit-@u.Id">Sửa</button>
                    <form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Khóa" : "Mở")</button></form>
                    @if (u.IsLockedOut)
                    {
                        <form asp-action="Unlock" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-success">Mở khoá</button></form>
                    }
                    else
                    {
                        <form asp-action="Lock" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-danger">Khoá</button></form>
                    }
                    <form asp-action="ResetPassword" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" /><input name="newPassword" type="text" class="form-control form-control-sm d-inline-block" style="width:120px" placeholder="Mật khẩu mới" /><button class="btn btn-sm btn-outline-primary">Đặt lại</button></form>
                </td>
            </tr>
            <tr class="collapse" id="edit-@u.Id"><td colspan="7" class="bg-light">
                <form asp-action="Update" method="post">@Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <div class="small text-muted mb-2">Cập nhật hồ sơ theo <b>cột cho phép</b> (port từ iNOS <code>SysUserUpdateX</code> / <code>Ft_Cols_Upd</code>): chỉ các cột được tích mới ghi, cột khác giữ nguyên.</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="Email" class="form-check-input" /> <span class="form-check-label">Email</span></label>
                            <input name="email" type="email" class="form-control form-control-sm" value="@u.Email" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="FullName" class="form-check-input" /> <span class="form-check-label">Họ tên</span></label>
                            <input name="fullName" class="form-control form-control-sm" value="@u.FullName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="Roles" class="form-check-input" /> <span class="form-check-label">Vai trò (csv)</span></label>
                            <input name="roles" class="form-control form-control-sm" value="@u.Roles" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="Tenant" class="form-check-input" /> <span class="form-check-label">Tổ chức</span></label>
                            <input name="tenant" class="form-control form-control-sm" value="@u.Tenant" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="OrgId" class="form-check-input" /> <span class="form-check-label">Đơn vị</span></label>
                            <select name="orgId" class="form-select form-select-sm">
                                <option value="">— Không gắn đơn vị —</option>
                                @foreach (var o in orgs)
                                {
                                    <option value="@o.Id" selected="@(u.OrgId == o.Id)">@o.BuCode · @o.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="IsActive" class="form-check-input" /> <span class="form-check-label">Hoạt động</span></label>
                            <div><input type="checkbox" name="isActive" value="true" class="form-check-input" checked="@u.IsActive" /></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-check"><input type="checkbox" name="columns" value="IsSysAdmin" class="form-check-input" /> <span class="form-check-label">SysAdmin</span></label>
                            <div><input type="checkbox" name="isSysAdmin" value="true" class="form-check-input" checked="@u.IsSysAdmin" /></div>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-sm btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu hồ sơ</button>
                        </div>
                    </div>
                </form>
            </td></tr>
        }
        </tbody></table>
    </div></div></div>
</div>
